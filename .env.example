# LifeFlow Environment Configuration

# API Configuration
API_BASE_URL=https://api.lifeflow.app
API_VERSION=v1

# Database
DATABASE_PATH=lifeflow.db
DATABASE_ENCRYPTION_KEY=your_encryption_key_here

# Sync Configuration
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=15
ICLOUD_SYNC_ENABLED=false
WEBDAV_SYNC_ENABLED=false
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=

# Security
BIOMETRIC_AUTH_ENABLED=true
AUTO_LOCK_MINUTES=5

# Notifications
PUSH_NOTIFICATIONS_ENABLED=true
DAILY_REMINDER_TIME=09:00
BILL_REMINDER_DAYS_BEFORE=3

# Features
ANALYTICS_ENABLED=true
CRASH_REPORTING_ENABLED=true
